
-- 1. Crear la base de datos
CREATE DATABASE IF NOT EXISTS db_backend
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

-- 2. Crear el usuario de MySQL
-- Cambiar la contraseña de ejemplo antes de ejecutar
CREATE USER IF NOT EXISTS 'user_backend'@'localhost'
IDENTIFIED BY 'CAMBIAR_POR_CONTRASENA_SEGURA';

-- 3. Asignar permisos
GRANT ALL PRIVILEGES ON db_backend.*
TO 'user_backend'@'localhost';

-- 4. Aplicar los cambios
FLUSH PRIVILEGES;
